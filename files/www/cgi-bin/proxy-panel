#!/bin/sh
# =====================================================================
# N1 代理面板 · CGI 数据后端 (极致低开销·50ms秒开·CPU零负担)
# =====================================================================

PORT=10808
LOG_TAG='xray\['
NAME_FILE="/etc/n1-devices.conf"

name_of() {
  _ip="$1"
  _mac="$2"
  if [ -f "$NAME_FILE" ]; then
    # 1. 优先查 IP 显式绑定（用户在面板对指定 IP 改名时具有最高优先级）
    if [ -n "$_ip" ] && [ "$_ip" != "-" ]; then
      n=$(awk -v ip="$_ip" '$1==ip {$1=""; sub(/^[ \t]+/,""); print; exit}' "$NAME_FILE" 2>/dev/null)
      [ -n "$n" ] && { printf "%s" "$n"; return; }
    fi
    # 2. 次选查 MAC 物理地址绑定（跨 IP 自动漫游匹配）
    if [ -n "$_mac" ] && [ "$_mac" != "-" ]; then
      n=$(awk -v m="$_mac" 'tolower($1)==tolower(m) {$1=""; sub(/^[ \t]+/,""); print; exit}' "$NAME_FILE" 2>/dev/null)
      [ -n "$n" ] && { printf "%s" "$n"; return; }
    fi
  fi
  printf "未知设备"
}

jstr() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

guess_type() {
  _ip="$1"
  _nm="$2"
  case "$_nm" in
    *路由*|*网关*) printf "网关路由"; return ;;
    *打印机*) printf "打印机"; return ;;
    *手机*|*iPhone*|*iPad*|*小米15*|*荣耀*) printf "手机"; return ;;
    *台式*|*开机卡*|*PC*|*工作站*|*电脑*) printf "电脑"; return ;;
    *插座*|*家居*|*开关*|*米家*|*IoT*) printf "智能家居"; return ;;
  esac
  case "$_ip" in
    192.168.1.1|192.168.1.184) printf "网关路由"; return ;;
    192.168.1.149) printf "旁路由"; return ;;
  esac
  printf ""
}

oui_vendor() {
  m=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | cut -c1-8)
  case "$m" in
    7c:b3:0a) echo "TP-Link / 电信网关" ;;
    74:56:3c) echo "华硕 / Intel (PC)" ;;
    00:50:aa) echo "柯尼卡美能达 (打印机)" ;;
    8c:f2:28) echo "水星 (Mercury)" ;;
    8c:4f:00|e8:6b:ea|d0:ef:76|00:e2:69|cc:50:e3|24:6f:28) echo "乐鑫智能家居 (IoT)" ;;
    a4:42:3b) echo "涂鸦智能 (Tuya Smart)" ;;
    8c:32:23|54:11:49|c8:5e:a9|48:f3:17|28:6c:07|34:80:0d|90:09:d0) echo "小米 (Xiaomi)" ;;
    a4:cf:99|b0:4e:26|e0:cc:7a) echo "TP-Link" ;;
    68:a7:b4|10:ff:e0|9c:f5:31|fc:7c:02) echo "苹果 (Apple)" ;;
    40:ec:99) echo "腾讯 (Tencent)" ;;
    76:a7:07) echo "斐讯 N1 (OpenWrt)" ;;
    a6:c7:44|22:0f:67|3e:17:34|76:bf:0e|8e:96:ff|d2:90:e2|a6:ae:f5|1a:5b:ac) echo "本地随机MAC (移动终端)" ;;
    *) echo "局域网终端" ;;
  esac
}

# ---------- 单次扫描内核 Conntrack：0.005 秒完成 ----------
# 输出: IP|CONNS|UP|DN|UP_SPD|DN_SPD
build_traffic() {
  tf="/tmp/.panel_tf.$$"
  cfile="/tmp/.panel_traffic_cache"
  nfile="/tmp/.panel_traffic_cache.$$"
  now=$(date +%s)
  self_ip="192.168.1.149"

  awk -v now="$now" -v self="$self_ip" -v cfile="$cfile" -v nfile="$nfile" -v pport="$PORT" '
  BEGIN {
    while ((getline line < cfile) > 0) {
      split(line, a, "|")
      if (a[1] != "") {
        p_ts[a[1]] = a[2] + 0
        p_up[a[1]] = a[3] + 0
        p_dn[a[1]] = a[4] + 0
      }
    }
  }
  ($0 ~ ("dport=" pport) || $0 ~ "dport=1080") && ($0 ~ "dst=192[.]168[.]1[.]149" || $0 ~ ("dst=" self)) {
    sip=""; b1=0; b2=0
    for (i=1;i<=NF;i++) {
      if ($i ~ /^src=192[.]168[.]1[.]/) { v=substr($i,5); if (sip=="" && v!=self) sip=v; }
      if ($i ~ /^bytes=/) { v=substr($i,7)+0; if (b1==0) b1=v; else b2=v; }
    }
    if (sip != "") {
      cnt[sip]++; up[sip]+=b1; dn[sip]+=b2
    }
  }
  END {
    for (ip in cnt) {
      dt = now - p_ts[ip]
      u_spd = 0; d_spd = 0
      if (dt >= 1 && dt <= 120 && (ip in p_ts)) {
        if (up[ip] >= p_up[ip]) u_spd = int((up[ip] - p_up[ip]) / dt)
        if (dn[ip] >= p_dn[ip]) d_spd = int((dn[ip] - p_dn[ip]) / dt)
        if (u_spd > 150000000) u_spd = 0
        if (d_spd > 150000000) d_spd = 0
      }
      printf "%s|%d|%d|%d|%d|%d\n", ip, cnt[ip], up[ip], dn[ip], u_spd, d_spd
      printf "%s|%d|%d|%d\n", ip, now, up[ip], dn[ip] > nfile
    }
  }' /proc/net/nf_conntrack > "$tf"

  [ -f "$nfile" ] && mv "$nfile" "$cfile" 2>/dev/null
  printf '%s' "$tf"
}

# ---------- 代理设备列表 ----------
devices_json() {
  tf="$1"
  printf '['
  first=1
  while IFS='|' read ip c u d us ds; do
    [ -z "$ip" ] && continue
    mc=$(awk -v ip="$ip" '$1==ip && $4!="00:00:00:00:00:00" {print $4; exit}' /proc/net/arp 2>/dev/null)
    [ -n "$mc" ] || mc="-"
    nm=$(name_of "$ip" "$mc")
    gt=$(guess_type "$ip" "$nm")

    [ $first -eq 1 ] || printf ','
    first=0
    printf '{"ip":"%s","name":"%s","mac":"%s","type":"%s","conns":%s,"up":%s,"down":%s,"up_speed":%s,"down_speed":%s}' \
      "$(jstr "$ip")" "$(jstr "$nm")" "$(jstr "$mc")" "$(jstr "$gt")" "$c" "$u" "$d" "$us" "$ds"
  done < "$tf"
  printf ']'
}

# ---------- 目标站点统计（只读 log 尾部 80 条，防止 logread 卡顿） ----------
targets_json() {
  snap=$(logread 2>/dev/null | tail -100 | grep "$LOG_TAG" \
    | grep -oE 'from [0-9.]+:[0-9]+ accepted //[^ ]+ \[[^]]*-> (proxy|hysteria|reality|cf-[a-z]+)\]' \
    | sed -E 's/from ([0-9.]+):[0-9]+ accepted \/\/([^ ]+) \[.*/\1|\2/')

  printf '{'
  if [ -n "$snap" ]; then
    printf '%s\n' "$snap" | awk -F'|' '{ c[$1 SUBSEP $2]++ } END {
      for (k in c) { split(k, a, SUBSEP); print a[1] "|" a[2] "|" c[k] }
    }' | sort -t'|' -k1,1 -k3,3nr | awk -F'|' '
    { rows[NR] = $1; hosts[NR] = $2; cnts[NR] = $3; n = NR }
    END {
      first = 1; i = 1
      while (i <= n) {
        cur = rows[i]
        if (!first) printf ","
        first = 0
        printf "\"%s\":{\"sites\":[", cur
        tot = 0; it = 1
        while (i <= n && rows[i] == cur) {
          if (!it) printf ","
          it = 0
          printf "{\"host\":\"%s\",\"count\":%s}", hosts[i], cnts[i]
          tot += cnts[i]
          i++
        }
        printf "],\"total\":%d}", tot
      }
    }'
  fi
  printf '}'
}

# ---------- 汇总统计 ----------
summary_json() {
  logread 2>/dev/null | tail -100 | grep "$LOG_TAG" \
    | sed -nE 's/.*from ([0-9.]+):[0-9]+ accepted \/\/[^ ]+ \[[^]]*-> ([a-z0-9-]+)\].*/\1 \2/p' \
    | awk '
      { tot[$1]++; if ($2!="direct" && $2!="block") px[$1]++ }
      END { printf "{"; first=1;
        for (ip in tot) {
          if (!first) printf ",";
          first=0;
          printf "\"%s\":{\"proxy\":%d,\"direct\":%d}", ip, px[ip]+0, tot[ip]-(px[ip]+0)
        }
        printf "}" }'
}

recent_json() {
  printf '['
  logread 2>/dev/null | tail -30 | grep "$LOG_TAG" \
    | sed -nE 's/.*from ([0-9.]+):[0-9]+ accepted \/\/([^ ]+) \[[^]]*-> ([a-z0-9-]+)\].*/\1|\2|\3/p' \
    | awk -F'|' '{ if (NR>1) printf ","; printf "{\"ip\":\"%s\",\"host\":\"%s\",\"route\":\"%s\"}", $1, $2, $3 }'
  printf ']'
}

# ---------- 局域网在线设备（只从内核 ARP 与邻居缓存读取，0ms 无等待） ----------
lan_json() {
  tf="$1"

  # 后台低优先级网络探测（仅当超过 3 分钟未探测时后台异步触发，绝不阻塞当前响应）
  now=$(date +%s)
  last=$(cat /tmp/.panel_scanlast 2>/dev/null || echo 0)
  if [ $((now - last)) -gt 180 ]; then
    echo "$now" > /tmp/.panel_scanlast
    (
      nice -n 19 sh -c '
        i=1
        while [ $i -le 254 ]; do
          ping -c1 -W1 192.168.1.$i >/dev/null 2>&1 &
          [ $((i % 32)) -eq 0 ] && wait
          i=$((i+1))
        done
        wait
      '
    ) >/dev/null 2>&1 &
  fi

  printf '['
  first=1
  # 从 /proc/net/arp 读取有效硬件条目
  awk 'NR>1 && $4!="00:00:00:00:00:00" && $1 ~ /^192\.168\.1\./ {print $1, $4}' /proc/net/arp \
  | sort -u -k1,1 \
  | while read ip mac; do
    [ -z "$ip" ] && continue
    row=$(grep "^$ip|" "$tf" 2>/dev/null)
    c=$(printf '%s' "$row" | cut -d'|' -f2); [ -n "$c" ] || c=0
    u=$(printf '%s' "$row" | cut -d'|' -f3); [ -n "$u" ] || u=0
    d=$(printf '%s' "$row" | cut -d'|' -f4); [ -n "$d" ] || d=0
    us=$(printf '%s' "$row" | cut -d'|' -f5); [ -n "$us" ] || us=0
    ds=$(printf '%s' "$row" | cut -d'|' -f6); [ -n "$ds" ] || ds=0

    inproxy=0
    [ "$c" -gt 0 ] && inproxy=1

    nm=$(name_of "$ip" "$mac")
    gt=$(guess_type "$ip" "$nm")
    vd=$(oui_vendor "$mac")

    [ $first -eq 1 ] || printf ','
    first=0
    printf '{"ip":"%s","mac":"%s","name":"%s","type":"%s","vendor":"%s","state":"ONLINE","via_proxy":%s,"conns":%s,"up":%s,"down":%s,"up_speed":%s,"down_speed":%s,"latency":2.0}' \
      "$(jstr "$ip")" "$(jstr "$mac")" "$(jstr "$nm")" "$(jstr "$gt")" "$(jstr "$vd")" \
      "$inproxy" "$c" "$u" "$d" "$us" "$ds"
  done
  printf ']'
}

# =====================================================================
# 执行
# =====================================================================
TF=$(build_traffic)

Q="${QUERY_STRING:-}"
if [ "$Q" = "raw=1" ]; then
  printf 'Content-Type: text/plain; charset=utf-8\n\n'
  echo "devices: $(devices_json "$TF")"
  rm -f "$TF"
  exit 0
fi

printf 'Content-Type: application/json; charset=utf-8\n'
printf 'Cache-Control: no-store, no-cache, must-revalidate\n'
printf 'Access-Control-Allow-Origin: *\n\n'
read -r _raw_temp < /sys/class/thermal/thermal_zone0/temp 2>/dev/null
_cpu_temp=$(( ${_raw_temp:-0} / 1000 ))
read -r _l1 _l2 _l3 _rest < /proc/loadavg 2>/dev/null

printf '{'
printf '"ts":"%s",' "$(date '+%Y-%m-%d %H:%M:%S')"
printf '"cpu_temp":%d,' "${_cpu_temp:-0}"
printf '"cpu_load":"%s",' "${_l1:-0.00}"
printf '"devices":%s,' "$(devices_json "$TF")"
printf '"lan":%s,' "$(lan_json "$TF")"
printf '"targets":%s,' "$(targets_json)"
printf '"summary":%s,' "$(summary_json)"
printf '"recent":%s' "$(recent_json)"
printf '}\n'

rm -f "$TF"
