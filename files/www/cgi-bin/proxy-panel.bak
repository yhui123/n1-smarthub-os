#!/bin/sh
# =====================================================================
# N1 代理面板 · CGI 数据后端
# 输出 JSON，供 /proxy-panel.html 前端调用
# 路径: /cgi-bin/proxy-panel      数据 JSON
#       /cgi-bin/proxy-panel?raw=1 纯文本调试
# =====================================================================

PORT=10808
LOG_TAG='xray\['
NAME_FILE="/etc/n1-devices.conf"

# ---------- 名称映射 ----------
name_of() {
  ip="$1"
  if [ -f "$NAME_FILE" ]; then
    n=$(awk -v ip="$ip" '$1==ip {$1=""; sub(/^ +/,""); print; exit}' "$NAME_FILE" 2>/dev/null)
    [ -n "$n" ] && { printf "%s" "$n"; return; }
  fi
  printf "未知设备"
}

mac_of() {
  ip neigh show 2>/dev/null | awk -v ip="$1" '$1==ip {print $5; exit}'
}

jstr() {
  # 简单 JSON 字符串转义
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# ---------- 设备类型自动推断（纯域名证据，不猜） ----------
# 返回 "电脑" / "电视/盒子" / "手机·小米" / "手机·荣耀" / "Apple 设备" / ""（证据不足）
# 证据：该 IP 在 xray 日志中出现过的全部域名（去重，非采样）
hosts_of() {
  logread 2>/dev/null | grep "$LOG_TAG" | grep "from $1:" \
    | sed -nE 's/.*accepted \/\/([^ ]+).*/\1/p' | sed -E 's/:[0-9]+$//' | sort -u
}

guess_type() {
  _ip="$1"
  _h=$(hosts_of "$_ip")
  [ -z "$_h" ] && { printf ""; return; }

  _f=/tmp/.panel_h.$$.$RANDOM
  printf '%s\n' "$_h" > "$_f"

  # —— PC 强特征：桌面系统 / 办公 / 开发工具独有域名 ——
  _pc=$(grep -cE 'edge\.microsoft|workbuddy|codebuddy|skillhub|autodesk|office\.com|sharepoint|substrate\.office|antigravity|msn\.com|sogou-wallpaper|win\.update|windows\.com|oneclient\.sfx\.ms|smartscreen|microsoft' "$_f")
  # —— 电视/盒子强特征 ——
  _tv=$(grep -cE 'googlevideo|youtube\.com|netflix|hotstar|nflxvideo|leanback|androidtv' "$_f")
  # —— 手机厂商自有云服务（最硬的品牌证据）——
  _mi=$(grep -cE 'micloud|miui|pandora\.xiaomi|xiaomixiaoai|sys\.miui' "$_f")
  _ho=$(grep -cE 'honor\.com|hihonor' "$_f")
  _hw=$(grep -cE 'hicloud\.com|dbankcloud' "$_f")
  _ov=$(grep -cE 'coloros|oppomobile|heytap|vivoglobal|vivo\.com' "$_f")
  _ap=$(grep -cE 'icloud|mzstatic|aaplimg' "$_f")

  rm -f "$_f"

  # 判定优先级：PC 需 ≥2 条证据，避免被单条误伤；品牌手机证据 1 条即成立
  _r=""
  if [ "$_pc" -ge 2 ]; then _r="电脑"
  elif [ "$_tv" -ge 2 ]; then _r="电视/盒子"
  elif [ "$_mi" -ge 1 ]; then _r="手机·小米"
  elif [ "$_ho" -ge 1 ]; then _r="手机·荣耀"
  elif [ "$_hw" -ge 1 ]; then _r="手机·华为"
  elif [ "$_ov" -ge 1 ]; then _r="手机"
  elif [ "$_ap" -ge 1 ]; then _r="Apple 设备"
  fi
  printf '%s' "$_r"
}

# ---------- 收集设备流量 ----------
# 数据源1：conntrack 当前活跃连接的实时字节数
# 数据源2：xray 日志中出现过的设备（补上"现在空闲但用过代理"的设备，否则会漏）
devices_json() {
  ct=/tmp/.panel_ct.$$
  self_ip=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
  [ -n "$self_ip" ] || self_ip="192.168.1.149"
  awk -v PORT="$PORT" -v SELF_IP="$self_ip" '
  $0 ~ "dport="PORT {
    sip=""; sb=""; db=""
    for (i=1;i<=NF;i++) {
      if ($i ~ /^src=/)   { v=substr($i,5); if (sip=="") sip=v }
      if ($i ~ /^bytes=/) { v=substr($i,7)+0; if (sb=="") sb=v; else db=v }
    }
    if (sip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && sip != SELF_IP && sip !~ /^127\./) {
      cnt[sip]++; up[sip]+=sb; dn[sip]+=db
    }
  }
  END { for (ip in cnt) printf "%s|%d|%d|%d\n", ip, cnt[ip], up[ip], dn[ip] }' /proc/net/nf_conntrack \
  | sort -t'|' -k3 -rn > "$ct"

  # 日志里出现过的设备（近 400 条访问记录）
  lg=/tmp/.panel_lg.$$
  logread 2>/dev/null | grep "$LOG_TAG" \
    | sed -nE 's/.*from ([0-9.]+):[0-9]+ accepted.*/\1/p' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
    | grep -vE '^127\.|^0\.' | sort -u > "$lg"

  # 合并 IP 列表：活跃的排前面
  all=/tmp/.panel_all.$$
  { cut -d'|' -f1 "$ct"; cat "$lg"; } | awk '!seen[$0]++' \
    | grep -vE '^192\.168\.1\.149$|^127\.|^0\.' > "$all"

  printf '['
  first=1
  while read ip; do
    [ -z "$ip" ] && continue
    row=$(grep "^$ip|" "$ct")
    c=$(printf '%s' "$row" | cut -d'|' -f2); [ -n "$c" ] || c=0
    u=$(printf '%s' "$row" | cut -d'|' -f3); [ -n "$u" ] || u=0
    d=$(printf '%s' "$row" | cut -d'|' -f4); [ -n "$d" ] || d=0
    nm=$(name_of "$ip")
    mc=$(mac_of "$ip")
    [ -n "$mc" ] || mc="-"
    gt=$(guess_type "$ip")
    [ $first -eq 1 ] || printf ','
    first=0
    printf '{"ip":"%s","name":"%s","mac":"%s","type":"%s","conns":%s,"up":%s,"down":%s}' \
      "$(jstr "$ip")" "$(jstr "$nm")" "$(jstr "$mc")" "$(jstr "$gt")" "$c" "$u" "$d"
  done < "$all"
  printf ']'

  rm -f "$ct" "$lg" "$all"
}

# ---------- 收集每台设备访问的代理目标 ----------
targets_json() {
  snap=$(logread 2>/dev/null | grep "$LOG_TAG" \
    | grep -oE 'from [0-9.]+:[0-9]+ accepted //[^ ]+ \[[^]]*-> (proxy|hysteria|reality|cf-[a-z]+)\]' \
    | sed -E 's/from ([0-9.]+):[0-9]+ accepted \/\/([^ ]+) \[.*/\1|\2/')

  printf '{'
  if [ -n "$snap" ]; then
    # 先聚合成 设备IP|站点|次数，再按设备分组输出，避免逗号错位
    printf '%s\n' "$snap" | awk -F'|' '{ c[$1 SUBSEP $2]++ } END {
      for (k in c) { split(k, a, SUBSEP); print a[1] "|" a[2] "|" c[k] }
    }' | sort -t'|' -k1,1 -k3,3nr | awk -F'|' '
    { rows[NR] = $1; hosts[NR] = $2; cnts[NR] = $3; n = NR }
    END {
      first = 1
      i = 1
      while (i <= n) {
        cur = rows[i]
        if (!first) printf ","
        first = 0
        printf "\"%s\":{\"sites\":[", cur
        tot = 0; it = 1
        while (i <= n && rows[i] == cur) {
          if (!it) printf ","
          it = 0
          printf "{\"host\":\"%s\",\"count\":%s}", hosts[i], cnts[i]
          tot += cnts[i]
          i++
        }
        printf "],\"total\":%d}", tot
      }
    }
    '
  fi
  printf '}'
}

# ---------- 汇总统计 ----------
summary_json() {
  logread 2>/dev/null | grep "$LOG_TAG" \
    | sed -nE 's/.*from ([0-9.]+):[0-9]+ accepted \/\/[^ ]+ \[[^]]*-> ([a-z0-9-]+)\].*/\1 \2/p' \
    | awk '
      { tot[$1]++; if ($2!="direct" && $2!="block") px[$1]++ }
      END { printf "{"; first=1;
        for (ip in tot) {
          if (!first) printf ",";
          first=0;
          printf "\"%s\":{\"proxy\":%d,\"direct\":%d}", ip, px[ip]+0, tot[ip]-(px[ip]+0)
        }
        printf "}" }'
}

# ---------- 最近流水 ----------
recent_json() {
  printf '['
  logread 2>/dev/null | grep "$LOG_TAG" | tail -40 \
    | sed -nE 's/.*from ([0-9.]+):[0-9]+ accepted \/\/([^ ]+) \[[^]]*-> ([a-z0-9-]+)\].*/\1|\2|\3/p' \
    | awk -F'|' '{ if (NR>1) printf ","; printf "{\"ip\":\"%s\",\"host\":\"%s\",\"route\":\"%s\"}", $1, $2, $3 }'
  printf ']'
}

# ---------- MAC 厂商识别（常见 OUI 前缀） ----------
oui_vendor() {
  m=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | cut -c1-8)
  case "$m" in
    7c:b3:0a) echo "华为" ;;
    74:56:3c) echo "Intel" ;;
    8c:32:23) echo "小米" ;;
    a6:c7:44|22:0f:67|3e:17:34|76:bf:0e|8e:96:ff|d2:90:e2|a6:ae:f5) echo "本地随机MAC" ;;
    00:e2:69) echo "TP-Link" ;;
    a4:cf:99) echo "TP-Link" ;;
    54:11:49) echo "海康/安防" ;;
    a4:42:3b) echo "海尔" ;;
    c8:5e:a9) echo "ZTE" ;;
    68:a7:b4) echo "苹果" ;;
    *) echo "" ;;
  esac
}

# ---------- 局域网在线设备（ARP + 主动 ping 确认） ----------
lan_json() {
  # 在用代理的 IP 集合
  proxy_ips=$(cat /proc/net/nf_conntrack 2>/dev/null | grep "dport=$PORT" \
    | awk '{ print $7 }' | sed 's/src=//' | sort -u)

  # 后台全网段扫描（异步，每 5 分钟一次）：ping 全网段刷新 ARP 表，
  # 让从未经过 N1 的设备也能进 ARP（旁路由盲区补偿，不阻塞本次响应）
  net=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{split($2,a,"/"); split(a[1],b,"."); print b[1]"."b[2]"."b[3]"."; exit}')
  [ -n "$net" ] || net="192.168.1."
  now=$(date +%s)
  last=$(cat /tmp/.panel_scanlast 2>/dev/null || echo 0)
  if [ $((now - last)) -gt 300 ]; then
    echo "$now" > /tmp/.panel_scanlast
    (
      i=1
      while [ $i -le 254 ]; do
        ping -c1 -W1 "$net$i" >/dev/null 2>&1 &
        [ $((i % 32)) -eq 0 ] && wait
        i=$((i+1))
      done
      wait
    ) >/dev/null 2>&1 &
  fi

  # 临时文件带进程号：面板多端同时自动刷新时，CGI 并发互不干扰
  # （此前固定路径会导致 A 进程 rm 掉 B 正在用的文件 → 偶发「未发现局域网设备」）
  tmp=/tmp/.panel_lan.$$.txt
  : > "$tmp"

  # IPv4 邻居（含主路由）
  ip neigh show dev br-lan 2>/dev/null | grep -v FAILED \
    | awk '{ ip=$1; mac=$3; st=$NF; if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print ip"|"mac"|"st }' >> "$tmp"

  # 主动 ping 确认：STALE 只代表"以前见过"，ping 通才算当前在线（并发，每批 32 个）
  : > "${tmp}.ping"
  n=0
  while IFS='|' read ip mac st; do
    [ -n "$ip" ] || continue
    (ping -c1 -W1 "$ip" >/dev/null 2>&1 && echo "$ip" >> "${tmp}.ping") &
    n=$((n+1))
    [ $((n % 32)) -eq 0 ] && wait
  done < "$tmp"
  wait

  # 「最近见过」缓存（共享，10 分钟有效期）：本次 ping 通的合并进去。
  # 手机省电/无线丢包时单次 ping 不通不算离线，10 分钟内见过即算在线，
  # 消除「一会有一会没有」的闪断。原子 mv 写入，多进程并发安全。
  seen=/tmp/.panel_seen
  seen_new="${seen}.$$"
  {
    while IFS= read -r p_ip; do [ -n "$p_ip" ] && echo "$p_ip|$now"; done < "${tmp}.ping"
    while IFS='|' read s_ip s_ts; do
      [ -n "$s_ip" ] || continue
      [ $((now - s_ts)) -lt 600 ] && echo "$s_ip|$s_ts"
    done < "$seen" 2>/dev/null
  } | awk -F'|' '!($1 in s){s[$1]=$2; print}' > "$seen_new" 2>/dev/null
  mv "$seen_new" "$seen" 2>/dev/null

  printf '['
  awk -F'|' -v pf="${tmp}.ping" -v sf="$seen" -v now="$now" '
  BEGIN{
    while ((getline line < pf) > 0) ping[line]=1
    while ((getline line < sf) > 0) { split(line, f, "|"); if (now - f[2] < 600) seen[f[1]]=1 }
  }
  {
    ip=$1; mac=$2; st=$3
    if (ip in seenip) next
    seenip[ip]=1
    # 在线判定三通道：ping 通 / 10 分钟内见过 / 内核 ARP 刚确认(REACHABLE)
    # REACHABLE=本轮 ping 触发了 ARP 应答，ICMP 被设备防火墙拦掉的手机/电视靠这条判定在线
    if ((ip in ping) || (ip in seen) || st=="REACHABLE") st="ONLINE"
    n=split(ip, o, ".")
    printf "0|%03d.%03d.%03d.%03d|%s|%s|%s\n", o[1], o[2], o[3], o[4], ip, mac, st
  }' "$tmp" | sort -t'|' -k1,1 -k2,2 > "${tmp}.2"

  first=1
  while IFS='|' read ord skey ip mac st; do
    [ -z "$mac" ] && continue
    # 判断是否在用代理
    inproxy=0
    printf '%s\n' "$proxy_ips" | grep -qx "$ip" && inproxy=1
    # 名称
    nm=$(name_of "$ip")
    gt=$(guess_type "$ip")
    vd=$(oui_vendor "$mac")
    [ -n "$vd" ] || vd="未知厂商"
    [ -n "$st" ] || st="-"

    [ $first -eq 1 ] || printf ','
    first=0
    printf '{"ip":"%s","mac":"%s","name":"%s","type":"%s","vendor":"%s","state":"%s","via_proxy":%s}' \
      "$(jstr "$ip")" "$(jstr "$mac")" "$(jstr "$nm")" "$(jstr "$gt")" "$(jstr "$vd")" \
      "$(jstr "$st")" "$inproxy"
  done < "${tmp}.2"
  printf ']'

  rm -f "$tmp" "${tmp}.ping" "${tmp}.2" "$seen_new"
}

# =====================================================================
# 路由
# =====================================================================
Q="${QUERY_STRING:-}"

if [ "$Q" = "raw=1" ]; then
  printf 'Content-Type: text/plain; charset=utf-8\n\n'
  echo "devices: $(devices_json)"
  echo
  echo "summary: $(summary_json)"
  exit 0
fi

printf 'Content-Type: application/json; charset=utf-8\n'
printf 'Cache-Control: no-store\n'
printf 'Access-Control-Allow-Origin: *\n'
printf '\n'
printf '{'
printf '"ts":"%s",' "$(date '+%Y-%m-%d %H:%M:%S')"
printf '"devices":%s,' "$(devices_json)"
printf '"lan":%s,' "$(lan_json)"
printf '"targets":%s,' "$(targets_json)"
printf '"summary":%s,' "$(summary_json)"
printf '"recent":%s' "$(recent_json)"
printf '}\n'
