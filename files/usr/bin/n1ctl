#!/bin/sh
# =====================================================================
# n1ctl — N1 代理设备管控（命名 / 禁用 / 限速 / 分设备节点路由）
#
# 用法：
#   n1ctl node  <IP/尾号/名称/default> <节点>   设置全局默认或单设备出口节点
#               可选节点: cf-us | cf-jp | cf-sg | cf-hk | hysteria | reality | direct | default(跟随默认)
#   n1ctl name  <IP> <名称>       设置设备名（空=清除）
#   n1ctl block <IP>              禁用该设备的代理
#   n1ctl unblock <IP>            解除禁用
#   n1ctl limit <IP> <速率>       限速：每秒新建连接数（0=取消）
#   n1ctl list                    查看全部管控与分设备节点状态
#   n1ctl apply                   重新下发所有规则
#   n1ctl reset                   清空全部管控
# =====================================================================

BLOCK_FILE="/etc/n1-block.conf"
LIMIT_FILE="/etc/n1-limits.conf"
NAME_FILE="/etc/n1-devices.conf"
NODE_FILE="/etc/n1-device-nodes.conf"
CF_BEST_FILE="/etc/xray/cf-best.conf"
PORT=10808
NFT_TABLE="inet n1ctl"
BLOCK_RATE="1/minute"   # 禁用档：慢到等同阻断

die() { echo "错误: $*" >&2; exit 1; }

valid_ip() {
  case "$1" in
    192.168.*.*|10.*.*.*) ;;
    *) return 1 ;;
  esac
  case "$1" in *[!0-9.]*) return 1 ;; esac
  o4=${1##*.}
  [ -n "$o4" ] && [ "$o4" -ge 1 ] && [ "$o4" -le 254 ] && return 0
  return 1
}

resolve_target() {
  t="$1"
  case "$t" in
    default|global|all|def) echo "default"; return 0 ;;
  esac
  if valid_ip "$t"; then
    echo "$t"; return 0
  fi
  case "$t" in
    [0-9]|[0-9][0-9]|[0-9][0-9][0-9])
      _net=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{split($2,a,"/"); split(a[1],b,"."); print b[1]"."b[2]"."b[3]"."; exit}')
      [ -n "$_net" ] || _net="192.168.1."
      if valid_ip "${_net}${t}"; then
        echo "${_net}${t}"; return 0
      fi
      ;;
  esac
  if [ -f "$NAME_FILE" ] && [ -n "$t" ]; then
    m=$(grep -vE '^[[:space:]]*(#|$)' "$NAME_FILE" | grep -i "$t" | head -n 1 | awk '{print $1}')
    if [ -n "$m" ] && valid_ip "$m"; then
      echo "$m"; return 0
    fi
  fi
  return 1
}

normalize_node() {
  case "$1" in
    cf|cf-us|us|US) echo "cf-us" ;;
    cf-jp|jp|JP)    echo "cf-jp" ;;
    cf-sg|sg|SG)    echo "cf-sg" ;;
    cf-hk|hk|HK)    echo "cf-hk" ;;
    hysteria|hy2|hy) echo "hysteria" ;;
    reality|vless)  echo "reality" ;;
    direct|cn)      echo "direct" ;;
    default|auto|"") echo "default" ;;
    *) return 1 ;;
  esac
}

node_label() {
  case "$1" in
    hysteria) echo "🇺🇸 美国专线 · Hysteria2 (全站美IP·极速)" ;;
    reality)  echo "🇺🇸 美国专线 · Reality (全站美IP·稳定)" ;;
    cf-us)    echo "☁️ CF美国 (免费·仅CF站美IP)" ;;
    cf-jp)    echo "☁️ CF日本 (免费·仅CF站日IP)" ;;
    cf-sg)    echo "☁️ CF新加坡 (免费·全站新IP)" ;;
    cf-hk)    echo "☁️ CF香港 (免费·仅CF站港IP)" ;;
    direct)   echo "🏠 仅国内直连" ;;
    default)  echo "跟随全局默认" ;;
    *)        echo "$1" ;;
  esac
}

dev_name_of() {
  _q="$1"
  [ -f "$NAME_FILE" ] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$NAME_FILE" | awk -v ip="$_q" '$1 == ip { sub(/^[^ \t]+[ \t]+/, ""); print; exit }'
}

# ---------- 节点分配 ----------
do_node() {
  raw_target="$1"
  raw_node="$2"
  [ -n "$raw_target" ] || die "请指定目标（default 或 设备IP/尾号/名称）"
  target=$(resolve_target "$raw_target") || die "无法识别目标设备: $raw_target"
  node=$(normalize_node "$raw_node") || die "不支持的节点: $raw_node (可选: cf-us|cf-jp|cf-sg|cf-hk|hysteria|reality|direct|default)"

  if [ "$target" = "default" ] && [ "$node" = "default" ]; then
    die "全局默认节点不能设为 default，请指定具体节点（如 cf-us / hysteria / reality）"
  fi

  [ -f "$NODE_FILE" ] || printf '# N1 分设备节点配置\ndefault cf-us\n' > "$NODE_FILE"
  tmp="${NODE_FILE}.tmp"
  grep -v "^${target}[[:space:]]" "$NODE_FILE" > "$tmp" 2>/dev/null
  if [ "$target" = "default" ] || [ "$node" != "default" ]; then
    printf '%s %s\n' "$target" "$node" >> "$tmp"
  fi
  mv "$tmp" "$NODE_FILE"

  if [ "$node" = "hysteria" ]; then
    pgrep -f 'hysteria client' >/dev/null 2>&1 || /etc/init.d/hysteria start >/dev/null 2>&1
  fi

  if [ -x /usr/bin/n1-xray-gen ]; then
    /usr/bin/n1-xray-gen >/dev/null 2>&1 || die "生成 Xray 配置失败"
    /etc/init.d/xray restart >/dev/null 2>&1
  fi

  lbl=$(node_label "$node")
  if [ "$target" = "default" ]; then
    echo "已切换【全局默认出口】-> $lbl ($node)"
  else
    dnm=$(dev_name_of "$target")
    [ -n "$dnm" ] && dnm=" ($dnm)"
    if [ "$node" = "default" ]; then
      echo "已恢复设备 ${target}${dnm} -> 跟随全局默认节点"
    else
      echo "已设置设备 ${target}${dnm} 独立节点 -> $lbl ($node)"
    fi
  fi
}

# ---------- 名称 ----------
do_name() {
  ip="$1"; nm="$2"
  valid_ip "$ip" || die "IP 格式不对: $ip"
  [ -f "$NAME_FILE" ] || : > "$NAME_FILE"
  tmp="${NAME_FILE}.tmp"

  # 获取该 IP 当前对应的 MAC 地址（如果有）
  mac=$(awk -v ip="$ip" '$1==ip && $4!="00:00:00:00:00:00" {print tolower($4); exit}' /proc/net/arp 2>/dev/null)

  # 清理旧的 IP 映射与冲突的 MAC 映射
  if [ -n "$mac" ]; then
    grep -vE "^(${ip}|${mac})[[:space:]]" "$NAME_FILE" > "$tmp" 2>/dev/null
  else
    grep -v "^${ip}[[:space:]]" "$NAME_FILE" > "$tmp" 2>/dev/null
  fi
  mv "$tmp" "$NAME_FILE"

  if [ -n "$nm" ]; then
    nm=$(printf '%s' "$nm" | tr -d '\r\n\t')
    printf '%s\t%s\n' "$ip" "$nm" >> "$NAME_FILE"
    if [ -n "$mac" ]; then
      printf '%s\t%s\n' "$mac" "$nm" >> "$NAME_FILE"
    fi
    echo "已命名: $ip $([ -n "$mac" ] && echo "($mac)") -> $nm"
  else
    echo "已清除命名: $ip $([ -n "$mac" ] && echo "($mac)")"
  fi
}

# ---------- 禁用 ----------
do_block() {
  ip="$1"
  valid_ip "$ip" || die "IP 格式不对: $ip"
  [ -f "$BLOCK_FILE" ] || : > "$BLOCK_FILE"
  if grep -q "^${ip}$" "$BLOCK_FILE" 2>/dev/null; then
    echo "已是禁用状态: $ip"
  else
    printf '%s\n' "$ip" >> "$BLOCK_FILE"
    echo "已禁用该设备代理: $ip"
  fi
  apply_nft >/dev/null
  echo "  [nft] 规则已生效（未重启任何服务）"
}

do_unblock() {
  ip="$1"
  valid_ip "$ip" || die "IP 格式不对: $ip"
  [ -f "$BLOCK_FILE" ] || { echo "该设备未被禁用"; return 0; }
  tmp="${BLOCK_FILE}.tmp"
  grep -v "^${ip}$" "$BLOCK_FILE" > "$tmp" 2>/dev/null
  mv "$tmp" "$BLOCK_FILE"
  echo "已解除禁用: $ip"
  apply_nft >/dev/null
  echo "  [nft] 规则已更新"
}

# ---------- 限速 ----------
do_limit() {
  ip="$1"; rate="$2"
  valid_ip "$ip" || die "IP 格式不对: $ip"
  case "$rate" in
    ''|0) rate=0 ;;
    *[!0-9]*) die "速率只接受数字（如 200）: $rate" ;;
  esac
  [ -f "$LIMIT_FILE" ] || : > "$LIMIT_FILE"
  tmp="${LIMIT_FILE}.tmp"
  grep -v "^${ip}[[:space:]]" "$LIMIT_FILE" > "$tmp" 2>/dev/null
  mv "$tmp" "$LIMIT_FILE"
  if [ "$rate" != "0" ]; then
    printf '%s\t%s\n' "$ip" "$rate" >> "$LIMIT_FILE"
    echo "已限速: $ip -> 每秒 $rate 个新建连接"
  else
    echo "已取消限速: $ip"
  fi
  apply_nft
}

# ---------- nft 下发 ----------
apply_nft() {
  nft delete table $NFT_TABLE 2>/dev/null
  nft add table $NFT_TABLE 2>/dev/null
  nft add chain $NFT_TABLE input \
    '{ type filter hook input priority -155 ; policy accept ; }' 2>/dev/null

  n=0

  # 先下禁用规则
  if [ -f "$BLOCK_FILE" ]; then
    while read -r _ip; do
      case "$_ip" in ''|\#*) continue ;; esac
      valid_ip "$_ip" || continue
      n=$((n+1))
      s="b${n}"
      nft add set $NFT_TABLE "$s" '{ type ipv4_addr ; flags dynamic ; size 65535 ; }' 2>/dev/null
      nft add rule $NFT_TABLE input \
        ip saddr "$_ip" tcp dport "$PORT" \
        add @$s "{ ip saddr limit rate over ${BLOCK_RATE} burst 1 packets }" \
        reject with icmp port-unreachable 2>/dev/null \
        && echo "  [nft] 禁用规则: $_ip"
    done < "$BLOCK_FILE"
  fi

  # 再下限速规则（跳过已被禁用的 IP）
  if [ -f "$LIMIT_FILE" ]; then
    while read -r _ip _rate; do
      case "$_ip" in ''|\#*) continue ;; esac
      valid_ip "$_ip" || continue
      [ -n "$_rate" ] && [ "$_rate" -gt 0 ] 2>/dev/null || continue
      grep -q "^${_ip}$" "$BLOCK_FILE" 2>/dev/null && continue
      n=$((n+1))
      s="l${n}"
      nft add set $NFT_TABLE "$s" '{ type ipv4_addr ; flags dynamic ; size 65535 ; }' 2>/dev/null
      nft add rule $NFT_TABLE input \
        ip saddr "$_ip" tcp dport "$PORT" \
        add @$s "{ ip saddr limit rate over ${_rate}/second burst ${_rate} packets }" \
        reject with icmp port-unreachable 2>/dev/null \
        && echo "  [nft] 限速规则: $_ip @ ${_rate}/秒"
    done < "$LIMIT_FILE"
  fi

  [ "$n" = "0" ] && echo "  [nft] 无管控规则（已清空）"

  # 自动同步 /www/proxy.pac 中的本机 IP（支持跨网段换路由器后自动生效）
  _self_ip=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]; exit}')
  if [ -n "$_self_ip" ] && [ -f /www/proxy.pac ]; then
    sed -i "s/[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}\.[0-9]\{1,3\}:10808/${_self_ip}:10808/g" /www/proxy.pac 2>/dev/null
  fi
  return 0
}

# ---------- 查看 ----------
do_list() {
  def_node=$(awk '$1=="default"{print $2}' "$NODE_FILE" 2>/dev/null)
  [ -n "$def_node" ] || def_node="cf-us"
  cf_info=$(awk '{print $1":"$2" ("$3")"}' "$CF_BEST_FILE" 2>/dev/null)

  echo "=== 节点路由与分设备出口 ($NODE_FILE) ==="
  echo "  全局默认出口: $(node_label "$def_node") [$def_node]"
  [ -n "$cf_info" ] && echo "  CF 最快优选 : $cf_info"
  echo "  --------------------------------------------------------"
  if [ -f "$NAME_FILE" ]; then
    _gw_ip=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
    [ -n "$_gw_ip" ] || _gw_ip="192.168.1.1"
    grep -vE '^[[:space:]]*(#|$)' "$NAME_FILE" | while read -r line; do
      _ip=$(printf '%s' "$line" | awk '{print $1}')
      [ "$_ip" = "$_gw_ip" ] && continue
      _nm=$(printf '%s' "$line" | sed 's/^[[:space:]]*[^[:space:]]*[[:space:]]*//')
      _nd=$(awk -v ip="$_ip" '$1==ip{print $2}' "$NODE_FILE" 2>/dev/null)
      if [ -n "$_nd" ]; then
        printf "  %-16s %-22s -> [独立] %s (%s)\n" "$_ip" "$_nm" "$(node_label "$_nd")" "$_nd"
      else
        printf "  %-16s %-22s -> [默认] %s (%s)\n" "$_ip" "$_nm" "$(node_label "$def_node")" "$def_node"
      fi
    done
  fi
  echo
  echo "=== 已禁用代理 ==="
  b=$(grep -vE '^[[:space:]]*(#|$)' "$BLOCK_FILE" 2>/dev/null)
  if [ -n "$b" ]; then printf '%s\n' "$b" | while read -r ip; do echo "  $ip"; done
  else echo "  （无）"; fi
  echo
  echo "=== 已限速 ==="
  l=$(grep -vE '^[[:space:]]*(#|$)' "$LIMIT_FILE" 2>/dev/null)
  if [ -n "$l" ]; then
    printf '%s\n' "$l" | while read -r line; do
      _ip=$(printf '%s' "$line" | awk '{print $1}')
      _rate=$(printf '%s' "$line" | awk '{print $2}')
      echo "  $_ip -> ${_rate}/秒"
    done
  else echo "  （无）"; fi
}

# ---------- 重置 ----------
do_reset() {
  [ -f "$BLOCK_FILE" ] && : > "$BLOCK_FILE"
  [ -f "$LIMIT_FILE" ] && : > "$LIMIT_FILE"
  nft delete table $NFT_TABLE 2>/dev/null
  echo "已清空全部管控（禁用列表 / 限速列表 / nft 规则）"
}

# ---------- 路由 ----------
CMD="$1"; shift 2>/dev/null
case "$CMD" in
  node)    do_node "$1" "$2" ;;
  name)    do_name "$1" "$2" ;;
  block)   do_block "$1" ;;
  unblock) do_unblock "$1" ;;
  limit)   do_limit "$1" "$2" ;;
  list)    do_list ;;
  apply)   apply_nft ;;
  reset)   do_reset ;;
  "")
    do_list ;;
  *)
    cat <<'USAGE'
用法:
  n1ctl node <IP/尾号/设备名/default> <节点>
        设置全局默认或单台设备的代理节点
        可选节点: cf-us | cf-jp | cf-sg | cf-hk | hysteria | reality | direct | default
        示例:
          n1ctl node default cf-us       # 全局默认走 CF 美国
          n1ctl node 59 cf-us            # 192.168.1.59 (台式机) 走 CF 美国
          n1ctl node 小米 cf-jp          # 小米手机走 CF 日本
          n1ctl node 150 hysteria        # 192.168.1.150 走 Hysteria2
          n1ctl node 150 default         # 192.168.1.150 恢复跟随全局默认
  n1ctl name <IP> <名称>    设置设备名（空名称=清除）
  n1ctl block <IP>          禁用该设备代理
  n1ctl unblock <IP>        解除禁用
  n1ctl limit <IP> <速率>   限速：每秒新建连接数（0=取消）
  n1ctl list                查看全部状态
  n1ctl apply               重新下发 nft 规则
  n1ctl reset               清空全部管控
USAGE
    exit 1 ;;
esac
